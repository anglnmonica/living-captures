{
  "specId": "sources",
  "description": "Each capture's source answers, and says what the page expects. A failing status test means that tool is having problems today, which is what the capture is for.",
  "tests": [
    {
      "testId": "weather-source",
      "description": "The National Weather Service knows Berkeley, and its forecast comes from the San Francisco Bay Area office (MTR).",
      "steps": [
        {
          "httpRequest": {
            "url": "https://api.weather.gov/points/37.8716,-122.2727",
            "method": "get",
            "request": {
              "headers": {
                "User-Agent": "living-captures (https://github.com/anglnmonica/living-captures)",
                "Accept": "application/geo+json"
              }
            },
            "response": {
              "body": {
                "properties": {
                  "gridId": "MTR"
                }
              }
            },
            "statusCodes": [
              200
            ]
          }
        }
      ]
    },
    {
      "testId": "apod-source",
      "description": "NASA's Astronomy Picture of the Day page answers. The capture reads NASA's API first and falls back to this page when the API fails.",
      "steps": [
        {
          "checkLink": {
            "url": "https://science.nasa.gov/apod/",
            "statusCodes": [
              200
            ]
          },
          "onFail": [
            {
              "retry": {
                "limit": 2,
                "delay": 3000,
                "backoff": "exponential"
              }
            }
          ]
        }
      ]
    },
    {
      "testId": "status-github",
      "description": "GitHub reports no problems. This test fails while GitHub is having an incident.",
      "steps": [
        {
          "httpRequest": {
            "url": "https://www.githubstatus.com/api/v2/status.json",
            "method": "get",
            "response": {
              "body": {
                "status": {
                  "indicator": "none"
                }
              }
            },
            "statusCodes": [
              200
            ],
            "request": {
              "headers": {
                "User-Agent": "living-captures (https://github.com/anglnmonica/living-captures)",
                "Accept": "application/json"
              }
            }
          }
        }
      ]
    },
    {
      "testId": "status-anthropic",
      "description": "Anthropic reports no problems with Claude. This test fails during an incident.",
      "steps": [
        {
          "httpRequest": {
            "url": "https://status.anthropic.com/api/v2/status.json",
            "method": "get",
            "response": {
              "body": {
                "status": {
                  "indicator": "none"
                }
              }
            },
            "statusCodes": [
              200
            ],
            "request": {
              "headers": {
                "User-Agent": "living-captures (https://github.com/anglnmonica/living-captures)",
                "Accept": "application/json"
              }
            }
          }
        }
      ]
    },
    {
      "testId": "status-npm",
      "description": "npm reports no problems. This test fails during an incident.",
      "steps": [
        {
          "httpRequest": {
            "url": "https://status.npmjs.org/api/v2/status.json",
            "method": "get",
            "response": {
              "body": {
                "status": {
                  "indicator": "none"
                }
              }
            },
            "statusCodes": [
              200
            ],
            "request": {
              "headers": {
                "User-Agent": "living-captures (https://github.com/anglnmonica/living-captures)",
                "Accept": "application/json"
              }
            }
          }
        }
      ]
    },
    {
      "testId": "docs-tools-source",
      "description": "GitHub's search API answers a search for repositories tagged documentation.",
      "steps": [
        {
          "httpRequest": {
            "url": "https://api.github.com/search/repositories?q=topic:documentation&sort=stars&order=desc&per_page=1",
            "method": "get",
            "request": {
              "headers": {
                "User-Agent": "living-captures (https://github.com/anglnmonica/living-captures)",
                "Accept": "application/vnd.github+json"
              }
            },
            "statusCodes": [
              200
            ]
          }
        }
      ]
    }
  ]
}
