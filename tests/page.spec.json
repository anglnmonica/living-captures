{
  "specId": "page",
  "description": "The page shows today's captures the way a visitor sees them.",
  "tests": [
    {
      "testId": "page-shows-captures",
      "description": "The page loads and every card finishes loading: it shows its capture, or a clear error if that source failed today. A source outage doesn't fail this test; a broken page does.",
      "steps": [
        {
          "goTo": "http://localhost:8000/"
        },
        {
          "find": {
            "selector": "h1",
            "elementText": "Living captures"
          }
        },
        {
          "find": {
            "selector": "#weather .wear, #weather .error",
            "timeout": 10000
          }
        },
        {
          "find": {
            "selector": "#apod .apod, #apod .error",
            "timeout": 10000
          }
        },
        {
          "find": {
            "selector": "#status .tools, #status .error",
            "timeout": 10000
          }
        },
        {
          "find": {
            "selector": "#docs-tools h2",
            "elementText": "New documentation tools on GitHub"
          }
        },
        {
          "find": {
            "selector": "#german .word, #german .error",
            "timeout": 10000
          }
        },
        {
          "screenshot": {
            "path": "today.png",
            "directory": "site/data",
            "overwrite": "true"
          }
        }
      ]
    }
  ]
}
